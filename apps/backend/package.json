{
  "name": "@campbell/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "cross-env HTTP_PROXY=http://127.0.0.1:7890 HTTPS_PROXY=http://127.0.0.1:7890 wrangler deploy",
    "type-check": "pnpm exec tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply campbell-biology-pal-db --local",
    "db:migrate:prod": "cross-env HTTP_PROXY=http://127.0.0.1:7890 HTTPS_PROXY=http://127.0.0.1:7890 wrangler d1 migrations apply campbell-biology-pal-db --remote"
  },
  "dependencies": {
    "@campbell/shared": "workspace:*",
    "@hono/firebase-auth": "^1.4.2",
    "hono": "^4.9.2",
    "neo4j-driver": "^5.28.1",
    "openai": "^5.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.122.0"
  }
}
